# ============================================================================
# ADMINICULUM — BOXED DEPLOYMENT ENV EXAMPLE
# Canonical Core + Optional Feature Packs
# ============================================================================
# This file documents all environment variables.
# REQUIRED vars MUST be set at container start (via Azure Container Apps env,
# Azure Key Vault references, or docker-compose env_file).
# OPTIONAL vars have safe defaults; leave unset to disable the feature.
# LOCAL-DEV-ONLY vars are NOT needed in containers.
#
# For local development, copy this to .env and fill in real values.
# For production, inject via Azure Container Apps environment variables
# or Azure Key Vault secret references (recommended).
# ============================================================================

# ============================================================================
# SECTION 1 — REQUIRED: CANONICAL CORE
# ============================================================================
# These vars are required for the backend to start at all.

# PostgreSQL connection string (Azure Database for PostgreSQL / local dev)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/adminiculum?schema=public"

# JWT access token secret (min 32 chars, random per deployment)
JWT_SECRET="CHANGE-ME-TO-A-RANDOM-32-PLUS-CHAR-SECRET"

# ============================================================================
# SECTION 2 — REQUIRED: AUTHENTICATION
# ============================================================================
# One of these credential sets must be present for SharePoint/Microsoft Graph
# to function. Without any of these the app starts in "degraded" mode.

# --- Option A: Modern Azure App Registration (preferred) ---
AZURE_CLIENT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
AZURE_CLIENT_SECRET="your-azure-app-client-secret"
AZURE_TENANT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# --- Option B: SharePoint-specific App Registration (legacy pair) ---
# SHAREPOINT_CLIENT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# SHAREPOINT_SECRET="your-sharepoint-app-secret"

# --- Option C: SP Client Pair (alternative) ---
# SP_CLIENT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# SP_CLIENT_SECRET="your-sp-client-secret"

# Azure AD token validation (shared with frontend)
AZURE_AD_TENANT_ID="18b56834-dfea-4931-bdf8-e5ebb0cb4e0f"
AZURE_AD_AUDIENCE="api://a1e8b8a0-7690-4d09-9974-e4742d3de4e9"

# ============================================================================
# SECTION 3 — CANONICAL CORE: RUNTIME BEHAVIOR
# ============================================================================

NODE_ENV=production
PORT=3001

# Comma-separated CORS allowlist (production origins only)
# In Azure Container Apps, set to your frontend container URL
CORS_ALLOWED_ORIGINS=https://your-frontend.azurecontainerapps.io

# Frontend URL (used in CORS origin matching and OpenAPI server URL)
FRONTEND_URL="https://your-frontend.azurecontainerapps.io"

# Backend base URL for OpenAPI spec and host resolution
# WEBSITE_HOSTNAME is set automatically by Azure App Service
# WEBSITE_HOSTNAME="your-backend.azurewebsites.net"

# ============================================================================
# SECTION 4 — OPTIONAL: CONTRACT GENERATION FEATURE PACK
# ============================================================================
# Set ENABLE_CONTRACT_GENERATION=false to disable contract generation.
# Templates are baked into the image via Backend/templates/ copy.

ENABLE_CONTRACT_GENERATION=true

# Path to DOCX contract templates (relative to project root in image)
TEMPLATES_PATH="./templates"

# Temporary output directory for generated documents (ephemeral!)
OUTPUT_DIR="./output"

# ============================================================================
# SECTION 5 — OPTIONAL: AI / ANONYMIZATION FEATURE PACK
# ============================================================================
# Optional. If not set, anonymization endpoints return 501 Not Implemented.

# OpenAI API Key (for AI-powered document anonymization/redaction)
# OPENAI_API_KEY="sk-..."

# Claude API Key (alternative AI provider)
# CLAUDE_API_KEY="sk-ant-..."

# ============================================================================
# SECTION 6 — OPTIONAL: SHAREPOINT (if not using Azure App Registration)
# ============================================================================
# Only needed if Option B or C credential sets are used above.

# SP_TENANT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# SP_SITE_ID="{tenant-id},{site-web-id},{site-id}"
# SP_DRIVE_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# SHAREPOINT_SITE_URL="https://your-tenant.sharepoint.com/sites/LegalCases"

# ============================================================================
# SECTION 7 — OPTIONAL: LOCAL FILE STORAGE FALLBACK
# ============================================================================
# WARNING: Backend/uploads/ and Frontend/uploads/ are EPHEMERAL in containers.
# They reset on every container restart. For production file storage,
# use Azure Blob Storage or SharePoint. These vars enable a local fallback
# only — never rely on them in a containerized production deployment.

# ENABLE_LOCAL_STORAGE=false
# UPLOAD_DIR="./uploads"
# MAX_FILE_SIZE="52428800"  # 50MB

# ============================================================================
# SECTION 8 — OPTIONAL: JWT REFRESH TOKEN
# ============================================================================
# JWT_REFRESH_SECRET="CHANGE-ME-TO-ANOTHER-RANDOM-SECRET"
# JWT_EXPIRES_IN="1h"
# JWT_REFRESH_EXPIRES_IN="7d"

# ============================================================================
# SECTION 9 — LOCAL-DEV-ONLY: NOT NEEDED IN CONTAINERS
# ============================================================================
# These are for local development only. Do NOT set in container environments.

# Local dev uses dotenv-loaded .env for local PostgreSQL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/adminiculum"
# FRONTEND_URL="http://localhost:5173"
# PORT=3001

# Local dev uses tsx watch for hot reload:
# npm run dev  (not npm run start)

# Prisma migrate dev (not needed in containers — migrations run separately):
# npx prisma migrate dev

# Local secrets:
# SP_CLIENT_SECRET="local-dev-secret"
