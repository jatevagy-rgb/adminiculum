{
  "name": "lwp-backend",
  "version": "1.0.0",
  "description": "Legal Workflow Platform - Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:test": "set DOTENV_CONFIG_PATH=.env.test&& node -r dotenv/config ./node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:test": "set DOTENV_CONFIG_PATH=.env.test&& node -r dotenv/config dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:bootstrap": "prisma db push",
    "db:bootstrap:empty": "node scripts/db-bootstrap-empty.mjs",
    "db:migrations:verify-replay": "node scripts/verify-migration-replay.mjs",
    "test:migration:webjob": "node scripts/test-migration-webjob-runner.mjs",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "seed:pilot:users": "node scripts/seed-core-team-users.mjs",
    "seed:pilot:clients": "node scripts/seed-core-clients-house-style.mjs",
    "seed:test-user": "set DOTENV_CONFIG_PATH=.env.test&& node -r dotenv/config ./node_modules/tsx/dist/cli.mjs scripts/seedTestUser.ts",
    "test:workforce-qa": "jest --runInBand tests/workforceQaFixture.integration.test.ts",
    "seed:escalation-default": "node scripts/seed-escalation-default-rule.js",
    "test": "set DOTENV_CONFIG_PATH=.env.test&& node -r dotenv/config ./node_modules/jest/bin/jest.js",
    "test:comparison:db": "jest --runInBand tests/comparisonPersistence.integration.test.ts",
    "test:review:db": "jest --runInBand tests/documentReviewWorkflow.integration.test.ts",
    "test:publication:db": "jest --runInBand tests/clientPublicationFoundation.integration.test.ts",
    "test:automation:l1": "set DOTENV_CONFIG_PATH=.env.test&& node -r dotenv/config ./node_modules/jest/bin/jest.js --runInBand tests/automationSuggestions.accept.integration.test.ts",
    "azure:build": "npm run build",
    "verify:runtime:required": "node scripts/verify-runtime-required-endpoints.js",
    "connector:regen:runtime": "node scripts/regenerate-powerapps-canonical-from-runtime.js",
    "test:client-identity:db": "jest --runInBand tests/clientIdentityMembership.integration.test.ts",
    "test:client-interaction:db": "jest --runInBand tests/clientInteraction.integration.test.ts",
    "test:client-workspace:db": "jest --runInBand tests/clientPortalWorkspace.integration.test.ts",
    "test:company:db": "jest --runInBand tests/clientCompany.integration.test.ts tests/companyWorkspace.integration.test.ts",
    "test:contracts:db": "jest --runInBand tests/clientContractLibrary.integration.test.ts",
    "test:organization:db": "jest --runInBand tests/clientOrganization.integration.test.ts",
    "test:org-access:db": "jest --runInBand tests/clientPortalOrganizationalAccess.integration.test.ts",
    "test:phase5-fixture:db": "jest --runInBand tests/phase5OrgPortalFixture.integration.test.ts",
    "test:phase6-slice-a:db": "jest --runInBand tests/phase6SliceAFoundation.integration.test.ts",
    "test:phase6-slice-b:db": "jest --runInBand tests/phase6SliceBRequirementRule.integration.test.ts",
    "test:phase6-slice-c2:db": "jest --runInBand tests/phase6SliceC2Evaluation.integration.test.ts",
    "test:phase6-slice-d:db": "jest --runInBand tests/phase6SliceDRequirementApplicability.integration.test.ts",
    "test:phase7-slice-7a:db": "jest --runInBand tests/phase7Slice7AFindingMaterialization.integration.test.ts",
    "test:phase7d:db": "jest --runInBand tests/phase7DTypedFactFinding.integration.test.ts",
    "test:answer-state:db": "jest --runInBand tests/companyProfileAnswerState.integration.test.ts",
    "test:case-attention:db": "jest --runInBand tests/caseAttention.integration.test.ts",
    "test:work-package-schema:db": "jest --runInBand tests/workPackageSchema.integration.test.ts",
    "test:work-package-admin:db": "jest --runInBand tests/workPackageAdmin.integration.test.ts",
    "test:phase7b:db": "jest --runInBand tests/phase7BComplianceProposal.integration.test.ts",
    "test:phase7cb:db": "jest --runInBand tests/phase7CBComplianceOverview.integration.test.ts",
    "test:org-client-safe:db": "jest --runInBand tests/orgClientSafeComplianceReadModel.integration.test.ts",
    "test:phase5b:db": "jest --runInBand tests/phase5OrgPortalContractsCompany.integration.test.ts",
    "test:cp1-external-communication-docs:db": "jest --runInBand tests/clientPortalExternalCommunicationDocumentAccess.integration.test.ts",
    "test:intake:db": "jest --runInBand tests/clientPortalIntakeTriage.integration.test.ts",
    "test:membership-onboarding:db": "jest --runInBand tests/clientPortalMembershipOnboarding.integration.test.ts",
    "test:milestone:db": "jest --runInBand tests/clientMatterMilestonePublication.integration.test.ts",
    "test:workflow:db": "jest --runInBand tests/caseWorkflowTemplates.integration.test.ts",
    "test:lifecycle:db": "jest --runInBand tests/caseLifecycleWorkflowCompletion.integration.test.ts",
    "test:document-version:db": "jest --runInBand tests/documentVersionPersistence.integration.test.ts",
    "test:task-lifecycle-schema:db": "jest --runInBand tests/taskLifecycleSchema.integration.test.ts",
    "test:task-review-decision:db": "jest --runInBand tests/taskReviewDecision.integration.test.ts",
    "test:task-submission:db": "jest --runInBand tests/taskSubmission.integration.test.ts",
    "db:provision:task-document": "node scripts/ci-provision-task-document-dbs.mjs"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/keyvault-secrets": "^4.11.1",
    "@azure/msal-node": "^5.0.3",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@prisma/client": "^5.22.0",
    "@types/bcrypt": "^6.0.0",
    "@types/pdf-parse": "^1.1.5",
    "axios": "^1.13.5",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "docx": "^9.6.1",
    "docxtemplater": "^3.50.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-oauth2-jwt-bearer": "^1.7.4",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "jwks-rsa": "^3.2.2",
    "mammoth": "^1.11.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "pdf-parse": "^2.4.5",
    "pg": "^8.18.0",
    "pizzip": "^3.1.7",
    "prisma": "^5.22.0",
    "swagger-ui-express": "^5.0.1",
    "typescript": "^5.9.3",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.9",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/yamljs": "^0.2.34",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.5",
    "tsx": "^4.19.0"
  },
  "engines": {
    "node": ">=20 <21"
  },
  "prisma": {
    "seed": "node prisma/seed.js",
    "schema": "prisma/schema.prisma"
  }
}
