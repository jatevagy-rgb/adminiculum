# ============================================================================
# ADMINICULUM BACKEND CONFIGURATION
# ============================================================================
# This file documents canonical env names for local, staging and production.
# Never commit real secret values.

# ----------------------------------------------------------------------------
# Local / Staging / Production core
# ----------------------------------------------------------------------------

# Database (PostgreSQL with Prisma)
DATABASE_URL="postgresql://<db_user>:<db_password>@localhost:5432/adminiculum?schema=public"

# Application
NODE_ENV=development
PORT=3001

# Local dev login fallback (development only; never use in production)
LOCAL_DEV_LOGIN_EMAIL=hubay.mate@balintfy.onmicrosoft.hu
LOCAL_DEV_LOGIN_PASSWORD=Password123!
LOCAL_DEV_LOGIN_NAME="dr. HUBAY Gyula Máté"
# Legacy aliases still supported: DEV_LOGIN_EMAIL / DEV_LOGIN_PASSWORD / DEV_LOGIN_NAME
ENABLE_CONTRACT_GENERATION=false

# Azure AD / Entra token validation (production required when Azure AD tokens are used)
AZURE_AD_TENANT_ID="<azure-ad-tenant-id>"
AZURE_AD_AUDIENCE="api://<azure-api-app-id>"
# Optional descriptor (non-secret)
# AZURE_AD_CLIENT_ID="<azure-api-app-id>"

# Legacy compatibility aliases (optional; prefer AZURE_AD_* above)
# AZURE_TENANT_ID="<legacy-tenant-id>"
# AZURE_CLIENT_ID="<legacy-client-id>"

# Frontend URL hints (optional)
FRONTEND_URL="http://localhost:3000"
FRONTEND_ORIGIN="http://localhost:3000"

# CORS (production allowlist; comma-separated, explicit origins only)
# Example staging/prod:
# CORS_ALLOWED_ORIGINS=https://adminiculum-staging-web.azurewebsites.net,https://adminiculum-prod-web.azurewebsites.net
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================

# Access token secret (min 32 characters)
JWT_SECRET="<replace-with-long-random-secret>"

# Refresh token secret
JWT_REFRESH_SECRET="<replace-with-long-random-refresh-secret>"

# Token expiration
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# ============================================================================
# SHAREPOINT INTEGRATION (Microsoft Graph API)
# ============================================================================
#
# Setup Instructions:
# 1. Create App Registration in Azure Portal:
#    https://portal.azure.com/#view/Microsoft_AAD_IAM/ActiveDirectoryMenuBlade/RegisteredApps
#
# 2. Add API Permissions (Application permissions):
#    - Sites.ReadWrite.All
#    - Files.ReadWrite.All
#    - User.Read.All
#
# 3. Grant Admin Consent for the permissions
#
# 4. Find your Site ID and Drive ID:
#    - Use Graph Explorer: https://developer.microsoft.com/en-us/graph/graph-explorer
#    - GET https://graph.microsoft.com/v1.0/sites/root
#    - GET https://graph.microsoft.com/v1.0/sites/{site-id}/drives
#
# ============================================================================

# Canonical SharePoint app credentials (application permissions)
SP_TENANT_ID="<azure-tenant-id>"
SP_CLIENT_ID="<azure-client-id>"
SP_CLIENT_SECRET="<azure-client-secret>"

# SharePoint Site and Drive IDs (found using Graph API)
# Site ID format: {tenant-id},{site-web-id},{site-id}
SP_SITE_ID="<sharepoint-site-id>"
SP_DRIVE_ID="<sharepoint-drive-id>"

# Canonical site URL (used by drive service)
SHAREPOINT_SITE_URL="https://<tenant>.sharepoint.com/sites/<site-name>"
# Optional root folder hint
# SP_ROOT_FOLDER="/Cases"

# Legacy compatibility aliases (optional; prefer SP_* and SHAREPOINT_SITE_URL)
# AZURE_CLIENT_SECRET="<legacy-client-secret>"
# SP_SITE_URL="https://<tenant>.sharepoint.com/sites/<legacy-site-name>"
# SHAREPOINT_SITE_ID="<legacy-sharepoint-site-id>"
# SHAREPOINT_DRIVE_ID="<legacy-sharepoint-drive-id>"

# Note:
# - If SharePoint is not configured, diagnostics endpoint reports NOT_CONFIGURED.
# - Upload/download operations will return structured errors (no fake success).

# ============================================================================
# DOCUMENT GENERATION
# ============================================================================

# Template directory path (relative to project root)
TEMPLATES_PATH="./templates"

# Temporary output directory for generated documents
OUTPUT_DIR="./output"

# Maximum file size for uploads (in bytes)
MAX_FILE_SIZE="52428800"  # 50MB

# ============================================================================
# DOCUMENT STORAGE (Local Fallback - Primary is SharePoint)
# ============================================================================

# Local storage path for temporary files
UPLOAD_DIR="./uploads"

# Enable local file storage fallback (when SharePoint is unavailable)
ENABLE_LOCAL_STORAGE=false

# ============================================================================
# AI / ANONYMIZATION (Optional)
# ============================================================================

# AI Anonymization feature flag (set to true to enable)
ENABLE_AI_ANONYMIZATION=false

# OpenAI API Key (for AI-powered anonymization)
OPENAI_API_KEY="<openai-api-key>"

# Claude API Key (alternative AI provider)
CLAUDE_API_KEY="<claude-api-key>"

# ============================================================================
# GENERATION DRAFT (Optional)
# ============================================================================

# Generation Draft feature flag (set to true to enable)
ENABLE_GENERATION_DRAFT=false

# ============================================================================
# NEWS FEED (CORE - always enabled by default)
# ============================================================================

# News Feed feature flag (set to false to disable)
ENABLE_NEWS_FEED=true
