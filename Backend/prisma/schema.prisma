  caseId String

  status      LawyerHandoffStatus      @default(DRAFT)
  packageType LawyerHandoffPackageType @default(STANDARD)

  sourceDocumentId     String?
  anonymizedDocumentId String?
  generatedContractId  String?
  legalAnalysisId      String?
  reviewNotesId        String?

  preparerSummary String?

  preparedById String?
  submittedAt  DateTime?

  reviewedById   String?
  reviewedAt     DateTime?
  reviewDecision LawyerHandoffDecision?
  reviewComment  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, status])
  @@index([sourceDocumentId])
  @@index([legalAnalysisId])
  @@map("lawyer_handoff_packages")
}

// ============================================================================
// Structured document comparison (STRUCTURED-DOC-COMPARISON-1)
// Additive only. A comparison is always between two immutable DocumentVersion
// records of the same logical document; it never mutates versions and is never
// exposed to the Client Portal.
// ============================================================================

enum ComparisonStatus {
  PENDING
  PROCESSING
  READY
  IDENTICAL
  UNSUPPORTED
  FAILED
  SUPERSEDED
}

enum ChangeSegmentType {
  INSERT
  DELETE
  REPLACE
  MOVE_CANDIDATE
  FORMAT_ONLY
}

enum SegmentReviewState {
  UNREVIEWED
  ACCEPTED
  REJECTED
  NEEDS_DISCUSSION
  NOT_RELEVANT
}

enum SegmentCategory {
  PARTY
  DATE
  AMOUNT
  OBLIGATION
  LIABILITY
  TERMINATION
  GOVERNING_LAW
  DEFINITION
  OTHER
  UNCLASSIFIED
}

enum SegmentCategorySource {
  MANUAL
  RULE
  NONE
}

model DocumentComparison {
  id                   String           @id @default(uuid())
  documentId           String
  document             Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  baseVersionId        String
  baseVersion          DocumentVersion  @relation("ComparisonBaseVersion", fields: [baseVersionId], references: [id], onDelete: Restrict)
  targetVersionId      String
  targetVersion        DocumentVersion  @relation("ComparisonTargetVersion", fields: [targetVersionId], references: [id], onDelete: Restrict)
  status               ComparisonStatus @default(PENDING)
  algorithmRevision    Int
  extractionRevision   Int              @default(1)
  createdById          String
  createdBy            User             @relation("ComparisonCreatedBy", fields: [createdById], references: [id])
  createdAt            DateTime         @default(now())
  startedAt            DateTime?
  completedAt          DateTime?
  failureCode          String?
  failureMessageSafe   String?
  insertCount          Int              @default(0)
  deleteCount          Int              @default(0)
  replaceCount         Int              @default(0)
  formatOnlyCount      Int              @default(0)
  moveCandidateCount   Int              @default(0)
  totalSegmentCount    Int              @default(0)
  reviewedSegmentCount Int              @default(0)
  updatedAt            DateTime         @updatedAt

  segments DocumentChangeSegment[]

  // Controlled uniqueness: one comparison per (document, version pair, algorithm
  // revision) — makes creation idempotent and prevents duplicate jobs.
  @@unique([documentId, baseVersionId, targetVersionId, algorithmRevision])
  @@index([documentId])
  @@index([status])
  @@map("document_comparisons")
}

model DocumentChangeSegment {
  id                 String                @id @default(uuid())
  comparisonId       String
  comparison         DocumentComparison    @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  sequence           Int
  changeType         ChangeSegmentType
  baseStart          Int?
  baseEnd            Int?
  targetStart        Int?
  targetEnd          Int?
  baseExcerpt        String?
  targetExcerpt      String?
  contextBefore      String?
  contextAfter       String?
  confidence         Float                 @default(0)
  reviewState        SegmentReviewState    @default(UNREVIEWED)
  category           SegmentCategory       @default(UNCLASSIFIED)
  categorySource     SegmentCategorySource @default(NONE)
  internalRationale  String?
  // Soft references (validated in the service). Kept as plain columns rather
  // than FKs so the migration stays purely additive and never links a change
  // segment to the DocumentReview subsystem.
  linkedTaskId       String?
  linkedAnnotationId String?
  revision           Int                   @default(0)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  reviewPoints       ReviewPoint[]

  @@unique([comparisonId, sequence])
  @@index([comparisonId, sequence])
  @@index([comparisonId, reviewState])
  @@map("document_change_segments")
}

// ============================================================================
// CLIENT PORTAL INTERACTION FOUNDATION
// Additive, gate-guarded client-interaction domain: requests, questions,
// submissions, files, structured fields and transactional notification
