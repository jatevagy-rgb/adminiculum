model ClientRedactionProfile {
  id        String  @id @default(uuid())
  clientId  String  @unique
  client    Client  @relation(fields: [clientId], references: [id])
  fullName  String? // Full name for code compatibility
  aliases   Json? // Aliases for code compatibility
  addresses Json? // Addresses for code compatibility
  taxId     String? // Tax ID for code compatibility

  // Redaction Rules (JSON stored as text)
  patterns Json // [{ type: 'name', pattern: '...', replacement: '...' }]
  personas Json // [{ name: 'Person A', details: {...} }]

  // AI Anonymization Settings
  useLLM    Boolean @default(false)
  llmPrompt String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("client_redaction_profiles")
}

model AnonymousDocument {
  id        String @id @default(uuid())
  name      String // Original document name with _anon suffix
  content   String // Anonymized content
  addresses Json? // Addresses (code compatibility)

  // Reference to source
  sourceDocId    String
  sourceDocument Document @relation(fields: [sourceDocId], references: [id], onDelete: Restrict, map: "anonymous_documents_sourceDocId_fkey")

  redactedItems Json // Array of {type, original, replacement, position} for rehydration

  // AI task metadata
  aiTask        String? // AI task type (REVIEW_RISKS, COMPARE_TEMPLATE, SUMMARIZE, CUSTOM)
  customPrompt  String? // Custom AI instructions if aiTask is CUSTOM
  originalDocId String? // Original document ID (code compatibility)
  caseId        String? // Case ID (code compatibility)

  // Anonymization details
  redactedAt   DateTime @default(now())
  patternCount Int // Number of redactions applied

  // AI Response & Rehydration (added for Secure Bridge workflow)
  aiResponseText      String? // Raw AI response text imported from external AI
  rehydratedContent   String? // Rehydrated result with real names restored
  rehydrationStatus   String? // PENDING | COMPLETE | PARTIAL | FAILED
  rehydrationWarnings Json? // Array of unresolved token warnings
  rehydratedAt        DateTime? // When rehydration was performed

  // SharePoint (optional - could be uploaded)
  spItemId String?
  spWebUrl String?

  createdAt DateTime @default(now())

  @@map("anonymous_documents")
}

