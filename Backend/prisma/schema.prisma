model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  taskType    TaskType
  type        String? // For code compatibility (alternative to taskType)
  status      TaskStatus @default(PENDING)
  priority    Priority   @default(MEDIUM)

  // Assignment
  assignedToId   String?
  assignedTo     User?    @relation("AssignedTo", fields: [assignedToId], references: [id])
  assignedById   String? // Who assigned this task
  assignedBy     User?    @relation("AssignedBy", fields: [assignedById], references: [id])
  skillMatch     Float? // Score of skill matching (0-1)
  skillProfile   Json? // Required skills profile
  requiredSkills String[] // Required skills for this task

  // Document reference (if task is related to a document)
  documentId String?

  // Workflow Integration
  caseId        String
  case          Case    @relation(fields: [caseId], references: [id])
  workflowEvent String? // Event that triggered this task
  workflowInstanceId String?
  workflowTemplateKey String?
  workflowTemplateVersion Int?
  workflowStepKey String?
  workflowDependsOnKeys String[] @default([])
  workflowPublicMilestoneCandidate Boolean @default(false)
  workflowActivatedAt DateTime?

  // Matter reference (NEW)
  matterId String?
  matter   Matter? @relation(fields: [matterId], references: [id])

  // Task intelligence fields preserved from the deployed database
  stuckReason     TaskStuckReason?
  maturityStage   TaskMaturityStage?
  complexityScore Int                @default(3)
  riskScore       Int                @default(3)
  lastProgressAt  DateTime?
  stuckSince      DateTime?

  // Shared attention-category workload planning (candidate — additive, nullable).
  // Reuses the existing ReviewAttentionLevel enum (no new/renamed enum). Nullable
  // so legacy rows stay unclassified with no default; estimatedMinutes is an
  // optional explicit PLANNING estimate (never actual time — that stays in TimeEntry).
  attentionCategory ReviewAttentionLevel?
  estimatedMinutes  Int?

  // Dates
  dueDate     DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  submittedAt DateTime? // Submitted date (code compatibility)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  assignmentHistory     TaskAssignmentHistory[]
  sourceCommunication   Communication?          @relation("CommunicationTasks", fields: [sourceCommunicationId], references: [id])
  sourceCommunicationId String?
  submissions           TaskSubmission[]
  timeEntries           TimeEntry[]
  documentLinks         DocumentTaskLink[]
  reviewPoints          ReviewPoint[]
  remediationFindings   AssessmentFinding[]
  obligationRelated     ClientObligation[]

  @@index([complexityScore], map: "tasks_complexityScore_idx")
  @@index([maturityStage], map: "tasks_maturityStage_idx")
  @@index([riskScore], map: "tasks_riskScore_idx")
  @@index([stuckReason], map: "tasks_stuckReason_idx")
  @@index([workflowInstanceId])
  @@index([caseId, workflowInstanceId])
  @@map("tasks")
}

enum TaskType {
  REVIEW_CONTRACT
  DRAFT_CONTRACT
