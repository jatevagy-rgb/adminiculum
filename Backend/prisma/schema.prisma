// ============================================================================
// CLAUSE LIBRARY (Contract Assembly Foundation)
// ============================================================================
//
// Shared knowledge layer for contract CREATE / REVIEW / EDIT modes.
// Each clause is a structured record with trigger conditions, not raw text.
// ============================================================================

model ClauseLibraryItem {
  id String @id @default(uuid())

  // Identification
  title   String // Short human-readable title (e.g., "Eladói szavatosság")
  slug    String // URL-safe identifier (e.g., "elado-szavatossag")
  body    String // Full clause text (Hungarian legal prose)
  summary String? // One-line description for UI listings

  // Classification
  contractType    ClauseContractType
  clauseKind      ClauseKind // REQUIRED | RECOMMENDED | OPTIONAL | SPECIAL
  representedSide RepresentedSide // Which party this clause protects/favors
  category        ClauseCategory // PARTY | PROPERTY | WARRANTIES | PRICE | FINANCING | POSSESSION | TITLE | CLOSING | SPECIAL

  // Search & discovery
  keywords String[] // For clause search (e.g., ["szavatosság", "hibak", "kötelezettség"])
  isActive Boolean  @default(true)

  // Ordering
  sortOrder Int @default(0) // Display order within category
  version   Int @default(1)

  // Source tracking
  sourceType      String? // "STANDARD" | "BANK_TEMPLATE" | "CUSTOM"
  bankPackTag     String? // e.g., "OTP_BANK" | "GENERIC_BANK" — for bank-specific packs
  lawyerProfileId String? // Null = shared across all lawyers
  lawyerProfile   LawyerProfile? @relation(fields: [lawyerProfileId], references: [id])

  // Trigger conditions — simple key-value rules that the recommendation engine evaluates
  // Stored as JSON array: [{ field: "financingType", operator: "neq", value: "CASH" }]
  triggerConditions Json?

  // Relations
  assemblyClauses ContractAssemblyClause[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug, lawyerProfileId])
  @@index([contractType, clauseKind])
  @@index([representedSide])
  @@map("clause_library_items")
}

enum ClauseContractType {
  ADASVETEL
  BERLET
  MEGBIZAS
  MUNKASZERZODES
  VALLALKOZAS
  EGYEB
}

enum ClauseKind {
  REQUIRED // Always included in this contract type
  RECOMMENDED // Suggested by default, can be removed
  OPTIONAL // Not suggested, added manually
  SPECIAL // Conditional on specific facts (e.g., condominium, foreign party)
}

enum RepresentedSide {
  EITHER // Neutral clause applicable to both sides
  ELOADO // Favors/addresses the seller (Eladó)
  VEVO // Favors/addresses the buyer (Vevő)
  NEUTRAL // Procedural clause (határidők, jogszabályi hivatkozások)
}

enum ClauseCategory {
  PARTY // Felek megnevezése
  PROPERTY // Ingatlan leírás
  OWNERSHIP_PROOF // Tulajdonjog igazolása
  TITLE // Tulajdonjog, bejegyzés
  WARRANTIES // Szavatosság, nyilatkozatok
  PRICE // Vételár, fizetés
  FINANCING // Finanszírozás, bank, jelzálog
  POSSESSION // Birtokbaadás
  CLOSING // Záró rendelkezések, aláírás
  SPECIAL // Condominium, preemption, usufruct, farmland, etc.
}

// ============================================================================
// LAWYER PROFILE (Clause Preferences)
// ============================================================================
//
// Per-lawyer clause ordering and style preferences.
// Expandable to multiple lawyers in future passes.
// ============================================================================

model LawyerProfile {
  id String @id @default(uuid())

  // Lawyer identification
  lawyerName  String // e.g., "Dr. Trugly Csanád"
  lawyerEmail String? // Unique email for lookup

  // Style preferences
  preferredNumbering String? // "DECIMAL" | "ALPHA" | "ROMAN" | "BULLET"
  defaultClosingText String? // Standard closing clause text this lawyer uses

  // Notes
  styleNotes String? // Free-text notes on clause style preferences

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  clauses          ClauseLibraryItem[]
  preferredClauses LawyerPreferredClause[]
  assemblyDrafts   ContractAssemblyDraft[]

  @@unique([lawyerEmail])
  @@map("lawyer_profiles")
}

// Explicit ordering preference for a specific clause within a category
model LawyerPreferredClause {
  id              String        @id @default(uuid())
  lawyerProfileId String
  lawyerProfile   LawyerProfile @relation(fields: [lawyerProfileId], references: [id], onDelete: Cascade)
  clauseId        String

  // Override sort order for this lawyer
  sortOrder Int @default(0)

  // Whether this lawyer always includes this clause (even if OPTIONAL)
  alwaysInclude Boolean @default(false)

  // Whether this lawyer always excludes this clause
  alwaysExclude Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([lawyerProfileId, clauseId])
  @@map("lawyer_preferred_clauses")
}

// ============================================================================
// CONTRACT ASSEMBLY DRAFT (In-progress Contract Creation)
// ============================================================================
//
// Stores an in-progress contract assembly: intake answers, selected clauses,
// assembled body text, and linkage to the final generation payload.
// Reusable by future REVIEW and EDIT modes.
// ============================================================================

model ContractAssemblyDraft {
  id String @id @default(uuid())

  // Case reference
  caseId String

  // Contract type
  contractType ClauseContractType @default(ADASVETEL)

  // Intake answers (B400-style structured facts)
  intakeData Json // { representedSide, sellerCount, buyerCount, ... }

  // Assembled clause IDs and order
  selectedClauses Json // [{ clauseId, sortOrder, editedBody? }]

  // Final assembled text (for display/preview)
  assembledText String? // Concatenated clause bodies, ready for review

  // Status
  status AssemblyStatus @default(IN_PROGRESS)

  // Link to the lawyer profile used
  lawyerProfileId String?
  lawyerProfile   LawyerProfile? @relation(fields: [lawyerProfileId], references: [id])

  // Link to ContractTemplate used for final generation (if generated)
  templateId String?

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  // Relations
  clauses ContractAssemblyClause[]

  @@unique([caseId, contractType])
  @@index([caseId])
  @@index([lawyerProfileId])
  @@map("contract_assembly_drafts")
}

enum AssemblyStatus {
  IN_PROGRESS // User is still assembling
  READY // Ready to generate
  GENERATED // A contract has been generated from this assembly
}

// Junction table for assembly-to-clause relationship
model ContractAssemblyClause {
  id              String                @id @default(uuid())
  assemblyDraftId String
  assemblyDraft   ContractAssemblyDraft @relation(fields: [assemblyDraftId], references: [id], onDelete: Cascade)
  clauseId        String
  clause          ClauseLibraryItem     @relation(fields: [clauseId], references: [id], onDelete: Cascade)

  // Override: lawyer-edited body text (null = use clause.body as-is)
  editedBody String?

  // Position in the assembled contract
  sortOrder Int @default(0)

  // Whether this clause was manually added vs. auto-recommended
  isManual Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([assemblyDraftId, clauseId])
  @@index([assemblyDraftId])
  @@map("contract_assembly_clauses")
}

