model TaskSubmission {
  id                     String                @id @default(uuid())
  taskId                 String
  revisionNumber         Int
  status                 TaskSubmissionStatus  @default(DRAFT)
  createdById            String
  submittedById          String?
  assignedReviewerId     String
  workSummary            String?
  remainingIssues        String?
  reviewerNote           String?
  requestedAttention     ReviewAttentionLevel?
  externalActionRequired Boolean               @default(false)
  externalActionType     ExternalActionType?
  zeroTimeConfirmed      Boolean               @default(false)
  zeroTimeConfirmedById  String?
  zeroTimeConfirmedAt    DateTime?
  externalCompletedById  String?
  idempotencyKey         String?               @unique
  supersedesSubmissionId String?               @unique
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  submittedAt            DateTime?
  returnedAt             DateTime?
  approvedAt             DateTime?
  supersededAt           DateTime?
  externalCompletedAt    DateTime?

  task                 Task                      @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy            User                      @relation("TaskSubmissionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  submittedBy          User?                     @relation("TaskSubmissionSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedReviewer     User                      @relation("TaskSubmissionAssignedReviewer", fields: [assignedReviewerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  zeroTimeConfirmedBy  User?                     @relation("TaskSubmissionZeroTimeConfirmedBy", fields: [zeroTimeConfirmedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  externalCompletedBy  User?                     @relation("TaskSubmissionExternalCompletedBy", fields: [externalCompletedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supersedesSubmission TaskSubmission?           @relation("TaskSubmissionRevisionChain", fields: [supersedesSubmissionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supersededBy         TaskSubmission?           @relation("TaskSubmissionRevisionChain")
  documents            TaskSubmissionDocument[]
  reviewDecision       TaskReviewDecision?
  timeEntries          TaskSubmissionTimeEntry[]

  @@unique([taskId, revisionNumber])
  @@index([taskId, status])
  @@index([assignedReviewerId, status, submittedAt])
  @@index([submittedById, status, submittedAt])
  @@index([taskId, createdAt])
  @@map("task_submissions")
}

model TaskSubmissionDocument {
  id                String                     @id @default(uuid())
  submissionId      String
  documentId        String
  documentVersionId String?
  role              TaskSubmissionDocumentRole
  createdAt         DateTime                   @default(now())
  createdById       String

  submission      TaskSubmission   @relation(fields: [submissionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  document        Document         @relation(fields: [documentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  documentVersion DocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy       User             @relation("TaskSubmissionDocumentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([submissionId, documentId, role])
  @@index([documentId])
  @@index([documentVersionId])
  @@map("task_submission_documents")
}

model TaskReviewDecision {
  id                   String                 @id @default(uuid())
  submissionId         String                 @unique
  reviewerId           String
  decision             TaskReviewDecisionType
  note                 String?
  requestedCorrections String?
  requiresFullReview   Boolean                @default(false)
  correctionDeadline   DateTime?
  createdAt            DateTime               @default(now())

  submission TaskSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reviewer   User           @relation("TaskReviewDecisionReviewer", fields: [reviewerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([reviewerId, createdAt])
  @@map("task_review_decisions")
}

model TaskSubmissionTimeEntry {
  id           String   @id @default(uuid())
  submissionId String
  timeEntryId  String   @unique
  createdAt    DateTime @default(now())

  submission TaskSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
