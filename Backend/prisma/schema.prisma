  @@index([clientId, nextDueDate])
  @@index([sourceContractId, status])
  @@index([relatedTaskId])
  @@index([ownerPersonId])
  @@map("client_obligations")
}

enum ContractEntitlementStatus {
  ACTIVE
  EXERCISED
  EXPIRED
  WAIVED
}

model ContractEntitlement {
  id              String                      @id @default(uuid())
  contractId      String
  contract        ContractRecord              @relation(fields: [contractId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client                      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type            String
  title           String
  description     String?
  sourceReference String?
  exerciseByDate  DateTime?
  status          ContractEntitlementStatus   @default(ACTIVE)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  @@index([contractId, status])
  @@index([clientId, status])
  @@map("contract_entitlements")
}

// ============================================================================
// PHASE 3 — ORGANIZATION / RESPONSIBILITY MAP.
// OrganizationPerson is an operational responsibility record, DISTINCT from
// ClientPortalIdentity / ClientPortalMembership / internal User. A person may
// exist without any Adminiculum/portal account. ClientOrganizationGroup remains
// the canonical unit model (no second hierarchy). Extensible responsibility /
// document-role taxonomies are validated STRING codes via the server registry.
// No HRIS data is stored; HR-confidential classification is on the canonical
// Document layer and does not grant access.
// ============================================================================

enum DocumentSecurityClassification {
  STANDARD
  HR_CONFIDENTIAL
}

enum OrganizationPersonStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
  ENDED
}

model OrganizationPerson {
  id                       String                         @id @default(uuid())
  clientId                 String
  client                   Client                         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organizationGroupId      String?
  organizationGroup        ClientOrganizationGroup?        @relation(fields: [organizationGroupId], references: [id], onDelete: SetNull)
  managerPersonId          String?
  managerPerson            OrganizationPerson?             @relation("PersonManager", fields: [managerPersonId], references: [id], onDelete: SetNull)
  directReports            OrganizationPerson[]            @relation("PersonManager")
  deputyPersonId           String?
  deputyPerson             OrganizationPerson?             @relation("PersonDeputy", fields: [deputyPersonId], references: [id], onDelete: SetNull)
  isDeputyFor              OrganizationPerson[]            @relation("PersonDeputy")
  name                     String
  jobTitle                 String?
  employmentStatus         OrganizationPersonStatus        @default(ACTIVE)
  startDate                DateTime?
  endDate                  DateTime?
  responsibilitiesSummary  String?
  // Optional portal-membership link. This is NOT an authorization principal:
  // linking does not grant Case/Document access. Stored as a plain reference to
  // avoid coupling; validated in the service against the same Client workspace.
  portalMembershipId       String?
  responsibilities         OrganizationPersonResponsibility[]
  documentLinks            OrganizationPersonDocumentLink[]
  ownedContracts           ContractRecord[]
  ownedObligations         ClientObligation[]
  ownedInitiatives         DevelopmentInitiative[]
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt

  @@index([clientId, employmentStatus])
  @@index([clientId, organizationGroupId])
  @@index([managerPersonId])
  @@index([deputyPersonId])
  @@map("organization_persons")
}

model OrganizationPersonResponsibility {
  id                    String              @id @default(uuid())
  organizationPersonId  String
  organizationPerson    OrganizationPerson   @relation(fields: [organizationPersonId], references: [id], onDelete: Cascade)
  type                  String
  label                 String
  createdAt             DateTime             @default(now())

  @@index([organizationPersonId])
  @@map("organization_person_responsibilities")
}

model OrganizationPersonDocumentLink {
  id                   String             @id @default(uuid())
  organizationPersonId String
  organizationPerson   OrganizationPerson @relation(fields: [organizationPersonId], references: [id], onDelete: Cascade)
  documentVersionId    String
  documentVersion      DocumentVersion    @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  documentRole          String
  createdAt            DateTime           @default(now())

  @@unique([organizationPersonId, documentVersionId, documentRole])
  @@index([organizationPersonId])
  @@index([documentVersionId])
  @@map("organization_person_document_links")
}
