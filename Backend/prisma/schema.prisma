// ============================================================================
// ADMINICULUM DATABASE SCHEMA
// ============================================================================
//
// Architecture: Hybrid SharePoint + PostgreSQL
// - Documents: SharePoint (driveItems with SP metadata)
// - App Data: PostgreSQL (cases, tasks, users, timeline events)
//
// NEW: Client Time & Matter Visibility Module
// - Department: Client departments (HR, Legal, Compliance, etc.)
// - Matter: High-level legal matters under departments
// - TimeEntry: Billable hours tracked per matter
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER & AUTHENTICATION
// ============================================================================

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String?
  name         String
  role         UserRole   @default(LEGAL_ASSISTANT)
  status       UserStatus @default(ACTIVE)
  department   String?
  skills       String[] // JSON array of skills

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  assignedTasks                     Task[]                       @relation("AssignedTo")
  assignedByTasks                   Task[]                       @relation("AssignedBy") // Tasks assigned by this user
  createdCases                      Case[]                       @relation("CreatedBy")
  assignedCases                     Case[]                       @relation("AssignedLawyer")
  timelineEvents                    TimelineEvent[]
  comments                          Comment[]
  documentReviewSuggestions         DocumentReviewSuggestion[]   @relation("DocumentReviewSuggestionAuthor")
  createdDocumentReviews            DocumentReview[]             @relation("DocumentReviewCreatedBy")
  assignedDocumentReviews           DocumentReview[]             @relation("DocumentReviewAssignedReviewer")
  ownedDocumentReviews              DocumentReview[]             @relation("DocumentReviewOwner")
  createdDocumentReviewRounds       DocumentReviewRound[]        @relation("DocumentReviewRoundCreatedBy")
  createdReviewPoints               ReviewPoint[]                @relation("ReviewPointCreatedBy")
  ownedReviewPoints                 ReviewPoint[]                @relation("ReviewPointOwner")
  reviewDecisions                   ReviewDecision[]             @relation("ReviewDecisionActor")
  createdDocumentComparisons        DocumentComparison[]         @relation("ComparisonCreatedBy")
  reviewSnapshots                   ReviewSnapshot[]
  createdDocumentAnnotations        DocumentAnnotation[]         @relation("DocumentAnnotationCreatedBy")
  createdCaseExternalParticipants   CaseExternalParticipant[]    @relation("CaseExternalParticipantCreatedBy")
  responsibleDocuments              Document[]                   @relation("DocumentResponsible")
  reviewerDocuments                 Document[]                   @relation("DocumentReviewer")
  documentWorkInstructionUpdates    Document[]                   @relation("DocumentWorkInstructionUpdatedBy")
  createdDocumentTaskLinks          DocumentTaskLink[]           @relation("DocumentTaskLinkCreatedBy")
  createdCaseIntakeDeadlines        CaseIntakeDeadline[]         @relation("CaseIntakeDeadlineCreatedBy")
  responsibleCaseIntakeDeadlines    CaseIntakeDeadline[]         @relation("CaseIntakeDeadlineResponsible")
  assignedDocumentAnnotations       DocumentAnnotation[]         @relation("DocumentAnnotationAssignedTo")
  resolvedDocumentAnnotations       DocumentAnnotation[]         @relation("DocumentAnnotationResolvedBy")
  deletedDocumentAnnotations        DocumentAnnotation[]         @relation("DocumentAnnotationDeletedBy")
  createdDocumentAnnotationComments DocumentAnnotationComment[]  @relation("DocumentAnnotationCommentCreatedBy")
  deletedDocumentAnnotationComments DocumentAnnotationComment[]  @relation("DocumentAnnotationCommentDeletedBy")
  documentAnnotationEvents          DocumentAnnotationEvent[]    @relation("DocumentAnnotationEventActor")
  documentAnnotationAssignments     DocumentAnnotationEvent[]    @relation("DocumentAnnotationEventAssignedTo")
  caseCollaborations                CaseCollaborator[]
  documentVersions                  DocumentVersion[]
  taskAssignments                   TaskAssignmentHistory[]
  notifications                     Notification[]
  timeEntries                       TimeEntry[] // Time entries created by user
  createdTaskSubmissions            TaskSubmission[]             @relation("TaskSubmissionCreatedBy")
  submittedTaskSubmissions          TaskSubmission[]             @relation("TaskSubmissionSubmittedBy")
  assignedTaskSubmissions           TaskSubmission[]             @relation("TaskSubmissionAssignedReviewer")
  zeroTimeConfirmedTaskSubmissions  TaskSubmission[]             @relation("TaskSubmissionZeroTimeConfirmedBy")
  externalCompletedTaskSubmissions  TaskSubmission[]             @relation("TaskSubmissionExternalCompletedBy")
  createdTaskSubmissionDocuments    TaskSubmissionDocument[]     @relation("TaskSubmissionDocumentCreatedBy")
  taskReviewDecisions               TaskReviewDecision[]         @relation("TaskReviewDecisionReviewer")
  automationExecutionLogs           AutomationExecutionLog[]
  automationExecutionStepLogs       AutomationExecutionStepLog[]
  automationSuggestions             AutomationSuggestion[]
  automationTriggerEvents           AutomationTriggerEvent[]
  automationPreference              UserAutomationPreference?
  automationSuppressions            UserAutomationSuppression[]
  verifiedCompanyFacts               ClientFact[]
  createdCompanyMilestones           CompanyMilestone[]
  createdAssessments                 Assessment[]
  reviewedAssessmentItems            AssessmentItem[]
  createdAssessmentFindings          AssessmentFinding[]
  ownedDevelopmentInitiatives        DevelopmentInitiative[]
  lawFirmOwnedContracts               ContractRecord[]

  @@map("users")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserRole {
  ADMIN
  PARTNER
  LAWYER
  TRAINEE
  LEGAL_ASSISTANT
  CLIENT
  EXTERNAL_REVIEWER
  COLLAB_LAWYER
}

// ============================================================================
// CLIENT MANAGEMENT
// ============================================================================

enum ClientColorKey {
  RED
  ORANGE
  AMBER
  GREEN
  TEAL
  BLUE
  INDIGO
  PURPLE
  ROSE
  SLATE
}

model Client {
  id                        String                 @id @default(uuid())
  name                      String
  email                     String?
  phone                     String?
  address                   String?
  taxNumber                 String?
  companyRegistrationNumber String?
  authorizedRepresentative  String?
  company                   String?
  vatNumber                 String?
  contactPerson             String?
  notes                     String?
  color                     String?                @db.VarChar(16) // Legacy hexadecimal field; not a rendering source
  colorKey                  ClientColorKey?
  relationshipMode          ClientRelationshipMode @default(PORTAL_CENTRIC)
  portalAccessEnabled       Boolean                @default(false)
  connectedSystemState      String?                @db.VarChar(80)
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  // Relations
  cases             Case[]
  documents         Document[]
  departments       Department[] // Client departments
  matters           Matter[] // All matters for this client
  workgroups        ClientWorkgroup[] // Client workgroups for workload tracking
  redactorProfile   ClientRedactionProfile? // One-to-one relation for anonymization
  houseStyleProfile ClientHouseStyleProfile? // One-to-one relation for document house style
  operatingProfile  ClientOperatingProfile? // Company foundation (Phase 1)
  facts             ClientFact[] // Company foundation (Phase 1)
  companyMilestones CompanyMilestone[] // Company foundation (Phase 1)
  assessments       Assessment[] // Company foundation (Phase 1)
  assessmentFindings AssessmentFinding[] // Company foundation (Phase 1)
  developmentInitiatives DevelopmentInitiative[] // Company foundation (Phase 1)
  contractRecords ContractRecord[] // Contract library (Phase 2)
  obligations ClientObligation[] // Contract library (Phase 2)
  entitlements ContractEntitlement[] // Contract library (Phase 2)
  organizationPersons OrganizationPerson[] // Organization (Phase 3)

  @@map("clients")
}

enum ClientRelationshipMode {
  PORTAL_CENTRIC
  EMAIL_CENTRIC
  CONNECTED_SYSTEM
}

model ClientHouseStyleProfile {
  id       String @id @default(uuid())
  clientId String @unique

  officialName       String?
  shortName          String?
  registeredSeat     String?
  taxNumber          String?
  registrationNumber String?
  contactPerson      String?
  contactEmail       String?
  contactPhone       String?

  preferredLanguage    String?
  documentLanguageMode String?

  fontFamily     String?
  fontSize       String?
  headingStyle   String?
  numberingStyle String?

  headerRequirements String?
  footerRequirements String?
  signatureBlock     String?
  headerAssetPath    String?
  headerDescription  String?
  brandingNotes      String?

  bilingualNotes    String?
  translationNotes  String?
  preferredTone     String?
  prohibitedWording String?

  reusablePromptInstructions String?
  wordFormattingInstructions String?
  externalAiInstructions     String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_house_style_profiles")
}

// ============================================================================
// CLIENT WORKGROUPS (NEW)
// ============================================================================
//
// Workgroups for workload tracking per client
// Manually aggregated hours per period
// ============================================================================

model ClientWorkgroup {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  workloadRecords WorkloadRecord[]

  @@unique([clientId, name])
  @@index([clientId])
  @@map("client_workgroups")
}

// ============================================================================
// WORKLOAD RECORDS (NEW)
// ============================================================================
//
// Manually recorded workload hours per workgroup per period
// Period format: YYYY-MM
// ============================================================================

model WorkloadRecord {
  id            String   @id @default(uuid())
  period        String // YYYY-MM format
  reportedHours Float
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  workgroupId String
  workgroup   ClientWorkgroup @relation(fields: [workgroupId], references: [id], onDelete: Cascade)

  @@unique([workgroupId, period])
  @@index([workgroupId])
  @@map("workload_records")
}

// ============================================================================
// CLIENT DEPARTMENTS (NEW)
// ============================================================================
//
// Each client can have multiple departments (HR, Legal, Compliance, etc.)
// Matters belong to departments
// ============================================================================

model Department {
  id          String   @id @default(uuid())
  name        String // e.g., "HR", "Legal", "Compliance", "Finance"
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  matters     Matter[]
  timeEntries TimeEntry[]

  @@unique([clientId, name])
  @@map("departments")
}

// ============================================================================
// MATTERS (NEW)
// ============================================================================
//
// Matters are high-level legal matters/projects
// Cases belong to matters
// TimeEntries track work on matters
// ============================================================================

model Matter {
  id          String       @id @default(uuid())
  title       String // e.g., "Munkaszerződés módosítás projekt"
  description String?
  matterType  MatterType
  status      MatterStatus @default(OPEN)

  // Financial/Tracking info
  budgetHours  Float? // Estimated hours
  totalMinutes Int    @default(0) // Actual minutes logged

  // Dates
  openedAt  DateTime  @default(now())
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  cases       Case[]
  timeEntries TimeEntry[]
  tasks       Task[]

  @@map("matters")
}

enum MatterType {
  REAL_ESTATE
  EMPLOYMENT
  CONTRACT
  LITIGATION
  COMPLIANCE
  CORPORATE
  IP
  MERGERS_ACQUISITIONS
  OTHER
}

enum MatterStatus {
  OPEN
  ON_HOLD
  CLOSED
}

// ============================================================================
// TIME ENTRIES (NEW)
// ============================================================================
//
// Tracks billable hours per matter
// Visible to clients in client portal
// ============================================================================

model TimeEntry {
  id          String   @id @default(uuid())
  workType    WorkType
  description String // Client-friendly description (high-level only)
  minutes     Int // Time spent in minutes
  billable    Boolean  @default(true)

  // Date of work (can be backdated)
  workDate DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  matterId String
  matter   Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  departmentId        String?
  department          Department?               @relation(fields: [departmentId], references: [id])
  taskId              String?
  task                Task?                     @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  timelineEvents      TimelineEvent[]
  taskSubmissionLinks TaskSubmissionTimeEntry[]

  @@index([matterId, workDate])
  @@index([taskId])
  @@map("time_entries")
}

model TimesheetReportInstance {
  id                     String                        @id @default(uuid())
  templateId             String
  templateFamily         TimesheetReportTemplateFamily
  reportPeriod           String
  clientId               String?
  clientName             String?
  matterId               String?
  matterName             String?
  caseId                 String?
  caseReference          String?
  presetId               String?
  monthlyClosure         String?
  pendingOpenMattersNote String?
  clientClosingText      String?
  defaultLawyerName      String?
  carriedHours           Float                         @default(0)
  overtimeHours          Float                         @default(0)
  aboveThresholdHours    Float                         @default(0)
  rows                   Json
  totalsSnapshot         Json
  status                 TimesheetReportInstanceStatus @default(DRAFT)
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt

  renderedArtifacts TimesheetReportArtifact[]

  @@index([updatedAt])
  @@index([reportPeriod])
  @@map("timesheet_report_instances")
}

model TimesheetReportArtifact {
  id               String                        @id @default(uuid())
  reportInstanceId String
  reportInstance   TimesheetReportInstance       @relation(fields: [reportInstanceId], references: [id], onDelete: Cascade)
  format           TimesheetReportArtifactFormat
  mimeType         String
  fileName         String
  contentText      String?
  contentBase64    String?
  createdAt        DateTime                      @default(now())

  @@index([reportInstanceId, createdAt])
  @@map("timesheet_report_artifacts")
}

model TimesheetPreset {
  id                     String                        @id @default(uuid())
  name                   String
  templateFamily         TimesheetReportTemplateFamily
  layer                  TimesheetPresetLayer
  lawyerId               String?
  lawyerName             String?
  clientId               String?
  clientName             String?
  monthlyClosure         String?
  pendingOpenMattersNote String?
  clientClosingText      String?
  defaultLawyerName      String?
  isActive               Boolean                       @default(true)
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt

  @@index([templateFamily, isActive])
  @@index([layer, isActive])
  @@index([templateFamily, lawyerId, clientId, isActive])
  @@map("timesheet_presets")
}

enum TimesheetReportTemplateFamily {
  HU_DETAILED_MONTHLY
  CORPORATE_SUMMARY
}

enum TimesheetReportInstanceStatus {
  DRAFT
  GENERATED
}

enum TimesheetReportArtifactFormat {
  TEXT_V1
  DOCX_V1
}

enum TimesheetPresetLayer {
  TEMPLATE_DEFAULT
  LAWYER_DEFAULT
  CLIENT_DEFAULT
  CLIENT_LAWYER_OVERRIDE
}

enum WorkType {
  DRAFTING // Szerkesztés, tervezet készítés
  REVIEW // Átnézés, ellenőrzés
  CLIENT_CALL // Ügyfélhívás
  LEGAL_RESEARCH // Jogi kutatás
  INTERNAL_MEETING // Belső megbeszélés
  DOCUMENT_GENERATION // Dokumentum generálás
  COURT_PREPARATION // Bírósági felkészülés
  TRANSLATION // Fordítás
  ADMIN // Adminisztratív
  OTHER // Egyéb
}

// ============================================================================
// AUTOMATION FOUNDATION (PRESERVED FROM DEPLOYED DATABASE)
// ============================================================================

model UserAutomationPreference {
  id                 String   @id
  userId             String   @unique
  suggestionsEnabled Boolean  @default(true)
  level1Enabled      Boolean  @default(true)
  level2Enabled      Boolean  @default(true)
  level3Enabled      Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_automation_preferences_userId_fkey")

  @@map("user_automation_preferences")
}

model UserAutomationSuppression {
  id              String                    @id
  userId          String
  suppressionType AutomationSuppressionType
  value           String
  createdAt       DateTime                  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_automation_suppressions_userId_fkey")

  @@index([userId, suppressionType, value], map: "user_automation_suppressions_userId_suppressionType_value_idx")
  @@map("user_automation_suppressions")
}

model AutomationTriggerEvent {
  id           String                @id
  userId       String
  entityType   AutomationEntityType
  entityId     String
  screen       String
  actionType   String
  actionKey    String
  payloadClass String?
  contextKey   String
  source       AutomationEventSource @default(HUMAN)
  createdAt    DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "automation_trigger_events_userId_fkey")

  @@index([createdAt], map: "automation_trigger_events_createdAt_idx")
  @@index([userId, contextKey], map: "automation_trigger_events_userId_contextKey_idx")
  @@index([userId, entityType, entityId], map: "automation_trigger_events_userId_entityType_entityId_idx")
  @@map("automation_trigger_events")
}

model AutomationSuggestion {
  id                    String                    @id
  userId                String
  entityType            AutomationEntityType
  entityId              String
  suggestionType        AutomationSuggestionType
  suggestedActionKey    String
  suggestedPayloadClass String?
  confidence            Float
  contextKey            String
  state                 AutomationSuggestionState
  expiresAt             DateTime
  createdAt             DateTime                  @default(now())
  processingStartedAt   DateTime?
  bundlePreview         Json?

  user              User                         @relation(fields: [userId], references: [id], onDelete: Cascade, map: "automation_suggestions_userId_fkey")
  executionLogs     AutomationExecutionLog[]
  executionStepLogs AutomationExecutionStepLog[]

  @@index([userId, entityType, entityId, state], map: "automation_suggestions_userId_entityType_entityId_state_idx")
  @@map("automation_suggestions")
}

model AutomationExecutionLog {
  id             String                    @id
  userId         String
  entityType     AutomationEntityType
  entityId       String
  suggestionId   String?
  executionMode  AutomationExecutionMode
  status         AutomationExecutionStatus
  resultSummary  String?
  rollbackData   Json?
  createdAt      DateTime                  @default(now())
  operationToken String?                   @unique
  startedAt      DateTime?
  finishedAt     DateTime?
  failureCode    String?
  failureDetails Json?

  user              User                         @relation(fields: [userId], references: [id], onDelete: Cascade, map: "automation_execution_logs_userId_fkey")
  suggestion        AutomationSuggestion?        @relation(fields: [suggestionId], references: [id], onDelete: SetNull, map: "automation_execution_logs_suggestionId_fkey")
  executionStepLogs AutomationExecutionStepLog[]

  @@index([createdAt], map: "automation_execution_logs_createdAt_idx")
  @@index([userId, entityType, entityId], map: "automation_execution_logs_userId_entityType_entityId_idx")
  @@map("automation_execution_logs")
}

model AutomationExecutionStepLog {
  id                    String                          @id
  executionLogId        String
  suggestionId          String?
  userId                String
  entityType            AutomationEntityType
  entityId              String
  executionMode         AutomationExecutionMode
  stepOrder             Int
  actionKey             String
  payloadClass          String?
  status                AutomationExecutionStatus
  actionPolicy          AutomationActionPolicy
  retryability          AutomationStepRetryability
  compensationReadiness AutomationCompensationReadiness
  compensationHint      String?
  attemptNumber         Int                             @default(1)
  resultSummary         String?
  failureCode           String?
  failureDetails        Json?
  executedAt            DateTime                        @default(now())
  finishedAt            DateTime?
  createdAt             DateTime                        @default(now())

  executionLog AutomationExecutionLog @relation(fields: [executionLogId], references: [id], onDelete: Cascade, map: "automation_execution_step_logs_executionLogId_fkey")
  suggestion   AutomationSuggestion?  @relation(fields: [suggestionId], references: [id], onDelete: SetNull, map: "automation_execution_step_logs_suggestionId_fkey")
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade, map: "automation_execution_step_logs_userId_fkey")

  @@unique([executionLogId, stepOrder], map: "automation_execution_step_logs_executionLogId_stepOrder_key")
  @@index([actionKey, createdAt], map: "automation_execution_step_logs_actionKey_createdAt_idx")
  @@index([status, createdAt], map: "automation_execution_step_logs_status_createdAt_idx")
  @@index([suggestionId], map: "automation_execution_step_logs_suggestionId_idx")
  @@index([userId, createdAt], map: "automation_execution_step_logs_userId_createdAt_idx")
  @@map("automation_execution_step_logs")
}

enum AutomationActionPolicy {
  SAFE_AUTOPILOT_ALLOWED
  USER_APPROVAL_REQUIRED
  NEVER_AUTOPILOT
}

enum AutomationCompensationReadiness {
  NONE
  COMPENSATION_READY
  MANUAL_COMPENSATION_REQUIRED
}

enum AutomationEntityType {
  TASK
  CASE
  DOCUMENT
}

enum AutomationEventSource {
  HUMAN
  AUTOMATION
}

enum AutomationExecutionMode {
  LEVEL1
  LEVEL2
  LEVEL3
}

enum AutomationExecutionStatus {
  SUCCESS
  FAILED
  SKIPPED
}

enum AutomationStepRetryability {
  RETRYABLE
  MANUAL_RETRY_ONLY
  NON_RETRYABLE
}

enum AutomationSuggestionState {
  OFFERED
  ACCEPTED
  DISMISSED
  EXPIRED
  PROCESSING
}

enum AutomationSuggestionType {
  NEXT_STEP
  ACTION_BUNDLE
}

enum AutomationSuppressionType {
  ACTION_KEY
  TEMPLATE_ID
}

// ============================================================================
// CASE MANAGEMENT
// ============================================================================

model Case {
  id          String     @id @default(uuid())
  caseNumber  String     @unique
  title       String
  description String?
  caseType    CaseType
  status      CaseStatus @default(CLIENT_INPUT)
  priority    Priority   @default(MEDIUM)

  // Additional fields for code compatibility
  clientName     String? // Computed from client relation
  matterType     String? // Computed from matter relation
  sharepointRoot String? // Base SharePoint path
  clientRole     String? // Case-level client role for generation/anonymization targeting (e.g., CLIENT, COUNTERPARTY, OPPOSING_COUNSEL, BENEFICIARY)
  sharepointSite String? // SharePoint site ID (code compatibility)
  caseAssignment Json? // Case assignment data (code compatibility)

  // SharePoint Integration
  spSiteId       String?
  spDriveId      String?
  spFolderPath   String? // /Cases/{caseNumber} - {clientName}
  spMainFolderId String?

  // Dates
  receivedAt  DateTime  @default(now())
  deadline    DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  // Matter relation (NEW - cases belong to matters)
  matterId String?
  matter   Matter? @relation(fields: [matterId], references: [id])

  createdById      String
  createdBy        User    @relation("CreatedBy", fields: [createdById], references: [id])
  assignedLawyerId String?
  assignedLawyer   User?   @relation("AssignedLawyer", fields: [assignedLawyerId], references: [id])

  // ---- Intake starting context (CASE-INTAKE-REDESIGN-1) -------------------
  // Structured, separately queryable answers captured at matter intake. These are
  // discrete columns rather than one generic note blob, so the matter overview and
  // later automation can read each dimension on its own.
  intakeOriginReason      String? // Miért indult az ügy?
  intakeCurrentSituation  String? // Mi a jelenlegi helyzet?
  intakeClientExpectation String? // Mit vár az ügyfél?
  intakeUrgentAction      String? // Van-e sürgős teendő?
  intakeNextStep          String? // Mi az első következő ügyvédi lépés?

  documents                 Document[]
  tasks                     Task[]
  timelineEvents            TimelineEvent[]
  comments                  Comment[]
  documentReviewSuggestions DocumentReviewSuggestion[]
  collaborators             CaseCollaborator[]
  legalAnalyses             LegalAnalysis[]
  lawyerHandoffPackages     LawyerHandoffPackage[]
  externalParticipants      CaseExternalParticipant[]
  intakeDeadlines           CaseIntakeDeadline[]
  developmentInitiatives    DevelopmentInitiative[]
  contractRecords           ContractRecord[]

  @@map("cases")
}

/// Non-user participants captured at intake: client contacts, opposing party and
/// other externals. A participant is never just a name — the role is required and
/// persisted, and `side` makes the adversarial position explicit.
model CaseExternalParticipant {
  id           String   @id @default(uuid())
  caseId       String
  name         String
  role         String // CLIENT_CONTACT, OPPOSING_PARTY, OPPOSING_COUNSEL, EXPERT, OTHER
  side         String   @default("OTHER") // CLIENT, OPPOSING, NEUTRAL, OTHER
  organization String?
  email        String?
  phone        String?
  note         String?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  case      Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy User @relation("CaseExternalParticipantCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([caseId])
  @@map("case_external_participants")
}

/// A typed, reminder-bearing deadline captured at intake. The domain distinguishes a
/// statutory/procedural deadline from an internal working target, so the type is
/// modelled explicitly instead of being flattened into one untyped date.
model CaseIntakeDeadline {
  id                    String   @id @default(uuid())
  caseId                String
  title                 String
  deadlineType          String // STATUTORY, CLIENT_COMMITMENT, INTERNAL, NEXT_ACTION, OTHER
  dueAt                 DateTime
  /// How the user expressed it: ABSOLUTE (picked a moment) or RELATIVE (in N units).
  inputMode             String   @default("ABSOLUTE")
  relativeValue         Int?
  relativeUnit          String? // MINUTE, HOUR, DAY, WEEK
  reminderMinutesBefore Int?
  responsibleId         String?
  note                  String?
  createdById           String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  case        Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
