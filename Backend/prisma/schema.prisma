model Communication {
  id             String            @id @default(uuid())
  type           CommunicationType
  subject        String
  senderName     String?
  senderEmail    String?
  recipientName  String?
  recipientEmail String?
  content        String? // Full message content
  summary        String? // AI-extracted summary

  // Linkage - using foreign keys directly to avoid relation conflicts
  caseId           String?
  /// Exactly one linked thread per case may be marked primary at intake.
  isPrimaryForCase Boolean    @default(false)
  sourcedDocuments Document[] @relation("DocumentSourceCommunication")
  clientId         String?
  documentId       String?

  // Provider-sourced email import foundation (Microsoft Graph / Outlook).
  // All additive + nullable so existing manually-logged rows remain valid and
  // the read-only list contract is unaffected. No ingestion is implemented yet.
  externalMessageId      String?                  @unique(map: "communications_externalMessageId_key") // Graph message id / internetMessageId — dedupe key
  providerConversationId String? // Graph conversationId — thread grouping (provider-derived, not a persisted thread model)
  mailboxAddress         String? // which mailbox the message was imported from
  direction              CommunicationDirection? // INBOUND / OUTBOUND (nullable: manual rows stay heuristic-only)
  receivedAt             DateTime? // Graph receivedDateTime
  sentAt                 DateTime? // Graph sentDateTime
  source                 CommunicationSource?     @default(MANUAL) // provenance; existing rows are MANUAL
  syncStatus             CommunicationSyncStatus? // import lifecycle
  importedAt             DateTime? // when ingested
  metadata               Json? // selected provider metadata only (not full raw headers)
  recipients             Json? // to/cc/bcc array [{ name?, email, kind }]

  // Meta
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations - optional back relations
  attachments  CommunicationAttachment[]
  relatedTasks Task[]                    @relation("CommunicationTasks")

  @@index([caseId, createdAt])
  @@index([clientId, createdAt])
  @@index([providerConversationId])
  @@map("communications")
}

enum CommunicationType {
  EMAIL
  PHONE
  MEETING
  LETTER
  NOTE
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
}

enum CommunicationSource {
  MANUAL
  OUTLOOK
}

enum CommunicationSyncStatus {
