  reviewStatus      DocumentVersionReviewStatus      @default(NOT_IN_REVIEW)
  publicationStatus DocumentVersionPublicationStatus @default(INTERNAL_ONLY)
  uploadSource      DocumentVersionUploadSource      @default(LAWYER_UPLOAD)
