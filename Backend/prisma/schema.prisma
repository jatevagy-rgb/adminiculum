model ClientPortalGrant {
  id                     String                       @id @default(uuid())
  clientUserId           String?
  clientPortalIdentityId String?
  workspaceId            String?
  clientId               String
  caseId                 String
  role                   ClientPortalGrantRole        @default(VIEWER)
  // CP1: typed participant dimension layered on the existing grant. Legacy grants
  // are backfilled to PARTICIPANT; REQUESTER/CLIENT_OWNER are never inferred.
  participantRole        ClientPortalParticipantRole?
  isRequester            Boolean                      @default(false)
  status                 ClientPortalGrantStatus      @default(INVITED)
  permissions            ClientPortalPermission[]
  validFrom              DateTime                     @default(now())
  validUntil             DateTime?
  invitedById            String
  activatedAt            DateTime?
  suspendedAt            DateTime?
  suspendedById          String?
  revokedAt              DateTime?
  revokedById            String?
  revocationReasonSafe   String?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  revision               Int                          @default(0)

  @@index([clientId, caseId, status])
  @@index([clientUserId, status])
  @@index([clientPortalIdentityId, status])
  @@index([workspaceId, status])
  @@map("client_portal_grants")
}

