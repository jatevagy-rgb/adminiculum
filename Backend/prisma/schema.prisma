enum ClientQuestionThreadStatus {
  OPEN
  INTERNAL_REVIEW
  ANSWERED
  CLOSED
}

model ClientQuestionThread {
  id                     String                            @id @default(uuid())
  clientId               String
  caseId                 String
  clientPortalIdentityId String
  // CP1: workspace context + category + lifecycle + creator membership. Additive;
  // existing threads default to category QUESTION and keep working under current
  // permissions.
  workspaceId            String?
  category               ClientPortalCommunicationCategory @default(QUESTION)
  createdByMembershipId  String?
  lastMessageAt          DateTime?
  archivedAt             DateTime?
  subject                String
  status                 ClientQuestionThreadStatus        @default(OPEN)
  assignedInternalUserId String?
  revision               Int                               @default(0)
  createdAt              DateTime                          @default(now())
  updatedAt              DateTime                          @updatedAt

  messages     ClientQuestionMessage[]
  participants ClientQuestionThreadParticipant[]
  readStates   ClientQuestionThreadReadState[]

  @@index([caseId, status])
  @@index([clientPortalIdentityId, status])
  @@index([workspaceId, status])
  @@map("client_question_threads")
}

// CP1: explicit external-communication participants (workspace memberships) with
// per-thread read/write flags. A thread is only visible to its participants.
model ClientQuestionThreadParticipant {
  id                    String                      @id @default(uuid())
  threadId              String
  thread                ClientQuestionThread        @relation(fields: [threadId], references: [id], onDelete: Cascade)
  workspaceMembershipId String
  participantRole       ClientPortalParticipantRole @default(PARTICIPANT)
  canRead               Boolean                     @default(true)
  canWrite              Boolean                     @default(false)
  joinedAt              DateTime                    @default(now())
  removedAt             DateTime?
  createdAt             DateTime                    @default(now())

  @@unique([threadId, workspaceMembershipId])
  @@index([workspaceMembershipId])
  @@map("client_question_thread_participants")
}

// CP1: per-participant read state for safe unread-count derivation.
model ClientQuestionThreadReadState {
  id                    String               @id @default(uuid())
  threadId              String
  thread                ClientQuestionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  workspaceMembershipId String
  lastReadMessageId     String?
  lastReadAt            DateTime?
  updatedAt             DateTime             @updatedAt

  @@unique([threadId, workspaceMembershipId])
  @@index([workspaceMembershipId])
  @@map("client_question_thread_read_states")
}

enum ClientQuestionAuthorType {
  CLIENT
  INTERNAL
}

model ClientQuestionMessage {
  id                     String                   @id @default(uuid())
  threadId               String
