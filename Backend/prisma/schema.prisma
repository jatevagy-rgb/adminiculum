  triggerType               String
  frequencyCode             String?
  nextDueDate               DateTime?
  status                    ClientObligationStatus @default(OPEN)
  relatedTaskId             String?
  relatedTask               Task?                 @relation(fields: [relatedTaskId], references: [id], onDelete: SetNull)
