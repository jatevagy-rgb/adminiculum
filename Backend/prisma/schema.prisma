  canonicalContracts       ContractRecord[]
  obligationEvidence       ClientObligation[]
  personDocumentLinks      OrganizationPersonDocumentLink[]

  @@unique([documentId, version])
  @@unique([documentId, id])
  @@index([documentId, isCurrent])
  @@index([previousVersionId])
