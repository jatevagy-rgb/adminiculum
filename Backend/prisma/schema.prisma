// ============================================================================
// DOCUMENT MANAGEMENT (SharePoint-backed)
// ============================================================================

model Document {
  id          String           @id @default(uuid())
  name        String
  description String?
  mimeType    String           @default("application/octet-stream")
  category    DocumentCategory

  // Code compatibility fields
  fileName     String? // Original file name
  documentType String? // Document type
  spPath       String? // SharePoint path
  spDriveId    String? // SharePoint drive ID
  version      String? // Document version
  folder       String? // Folder location

  // SharePoint Metadata
  spItemId       String? @unique // SharePoint DriveItem ID
  spWebUrl       String? // SharePoint web URL
  spParentPath   String? // SP folder path (e.g., /Cases/2024-001/02_Drafts)
  spVersionId    String? // SP version ID
  spCheckOutUser String? // Who has it checked out

  // Local Metadata
  currentVersion    Int     @default(1)
  currentVersionInt Int     @default(1)
  isLatest          Boolean @default(true)
  size              Int? // bytes
  checksum          String? // SHA-256 hash for change detection

  // Persistent workspace text for modified working copy documents
  workspaceText String? // Stores the workspace editor draft text when documentType = 'MODIFIED_WORKING_COPY'

  // Phase 3: HR-confidential security classification (canonical Document layer).
  // STANDARD documents are governed by the existing case-scoped authorization;
  // HR_CONFIDENTIAL additionally requires a privileged workforce role. The
  // classification itself does NOT grant access.
  securityClassification DocumentSecurityClassification @default(STANDARD)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  caseId   String
  case     Case   @relation(fields: [caseId], references: [id])
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  versions                DocumentVersion[]
  reviews                 DocumentReview[]
  annotations             DocumentAnnotation[]
  reviewSuggestions       DocumentReviewSuggestion[]
  anonymizedDocuments     AnonymousDocument[]
  documentComparisons     DocumentComparison[]
  comments                Comment[]
  timelineEvents          TimelineEvent[]
  taskSubmissionDocuments TaskSubmissionDocument[]

  // ---- Document work context (DOCUMENT-WORK-CONTEXT-1) --------------------
  // A filename is not a work instruction. These columns carry the operational
  // meaning of the LOGICAL document: what it is, why it is in the matter, what
  // must be done with it, who owns it and by when.
  //
  // Deliberately separate from per-version state:
  //   workStatus                       -> logical document work status (here)
  //   DocumentVersionReviewStatus      -> review state of ONE version
  //   DocumentVersionPublicationStatus -> publication state of ONE version
  title                      String? // human-readable title; fileName stays secondary
  documentRole               String? // role in the matter, e.g. DRAFT_CONTRACT, EVIDENCE
  workStatus                 DocumentWorkStatus @default(RECEIVED)
  workInstruction            String? // the current executable instruction, not a chat comment
  workInstructionUpdatedAt   DateTime?
  workInstructionUpdatedById String?
  responsibleId              String?
  reviewerId                 String?
  dueDate                    DateTime?
  workPriority               Priority?
  nextStep                   String?
  /// Provenance: the communication this document arrived on, where applicable.
  sourceCommunicationId      String?

  responsible              User?              @relation("DocumentResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  reviewer                 User?              @relation("DocumentReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  workInstructionUpdatedBy User?              @relation("DocumentWorkInstructionUpdatedBy", fields: [workInstructionUpdatedById], references: [id], onDelete: SetNull)
  sourceCommunication      Communication?     @relation("DocumentSourceCommunication", fields: [sourceCommunicationId], references: [id], onDelete: SetNull)
  taskLinks                DocumentTaskLink[]

  @@index([caseId, workStatus])
  @@index([responsibleId, workStatus])
  @@index([reviewerId, workStatus])
  @@index([dueDate])
  @@map("documents")
}

/// Explicit many-to-many between documents and tasks. A join model (rather than an
/// implicit relation) so the link records who made it and when, and so the unique
/// constraint makes a duplicate link impossible at the database level.
model DocumentTaskLink {
  id          String   @id @default(uuid())
  documentId  String
  taskId      String
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy User     @relation("DocumentTaskLinkCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([documentId, taskId])
  @@index([taskId])
  @@map("document_task_links")
}

/// Logical document work status. Distinct from version review state and from
/// publication state — a document can be IN_PROGRESS while its current version is
/// NOT_IN_REVIEW, and APPROVED work is not the same as a published version.
enum DocumentWorkStatus {
  RECEIVED
  WAITING_FOR_PROCESSING
  IN_PROGRESS
  INTERNAL_REVIEW
  CHANGES_REQUESTED
  APPROVED
  READY_FOR_CLIENT
  SENT
  ARCHIVED
}

enum DocumentCategory {
  CONTRACT
  CORRESPONDENCE
  EVIDENCE
  COURT_FILING
  INTERNAL_MEMO
  RESEARCH
  TEMPLATE
  CLIENT_INPUT
  OTHER
}

