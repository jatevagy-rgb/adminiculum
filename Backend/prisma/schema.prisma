// ============================================================================
// PHASE 1 — COMPANY FOUNDATION (generic, extensible).
// ClientOperatingProfile / ClientFact / CompanyMilestone / Assessment /
// AssessmentItem / AssessmentFinding / DevelopmentInitiative.
// Extensible taxonomies (fact type, milestone type, assessment type) are
// validated STRING codes via the server registry — NOT Prisma enums — so new
// post-release packs (SUPPLIER_READINESS, AI_GOVERNANCE, ...) never require a
// migration. Stable lifecycles use Prisma enums.
// No second Client / Task / Document / org-unit hierarchy is introduced.
// ============================================================================

model ClientOperatingProfile {
  id             String   @id @default(uuid())
  clientId       String   @unique
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status         String?
  summary        String?
  internalNote   String?
  lastReviewedAt DateTime?
  nextReviewAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("client_operating_profiles")
}

enum ClientFactVerificationStatus {
  UNVERIFIED
  CLIENT_PROVIDED
  DOCUMENT_VERIFIED
  LAW_FIRM_VERIFIED
}

model ClientFact {
  id                       String                      @id @default(uuid())
  clientId                 String
  client                   Client                      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type                     String
  value                    String
  validFrom                DateTime
  validTo                  DateTime?
  sourceReference          String?
  sourceDocumentVersionId  String?
  sourceDocumentVersion    DocumentVersion?            @relation(fields: [sourceDocumentVersionId], references: [id], onDelete: SetNull)
  verificationStatus       ClientFactVerificationStatus @default(UNVERIFIED)
  verifiedById             String?
  verifiedBy               User?                       @relation(fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt               DateTime?
  createdAt                DateTime                    @default(now())
