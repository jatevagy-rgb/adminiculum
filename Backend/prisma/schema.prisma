// CP1: customer-initiated intake — a distinct domain from workforce->customer
// requests, questions and submissions. Submitting intake never creates a Case,
// grant or publication; access begins only after explicit workforce triage.
model ClientPortalIntakeRequest {
  id                      String                    @id @default(uuid())
  workspaceId             String
  requesterMembershipId   String
  organizationGroupId     String?
  subject                 String
  descriptionSafe         String
  urgency                 ClientPortalIntakeUrgency @default(NORMAL)
  requestedDeadline       DateTime?
  status                  ClientPortalIntakeStatus  @default(DRAFT)
  linkedCaseId            String?
  // Internal-only triage fields. These MUST never appear in a customer DTO.
  internalTriageNote      String?
  triagedByInternalUserId String?
  // Customer-safe office response (e.g. more-information request / decline reason).
  customerResponseSafe    String?
  submittedSnapshot       Json?
  conversionFingerprint   String?
  submittedAt             DateTime?
  triagedAt               DateTime?
  linkedAt                DateTime?
  convertedAt             DateTime?
  closedAt                DateTime?
  revision                Int                       @default(0)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  attachments        ClientPortalIntakeAttachment[]
  informationRequests ClientRequest[]

  @@index([workspaceId, status])
  @@index([requesterMembershipId, status])
  @@index([organizationGroupId, status])
  @@index([linkedCaseId])
  @@map("client_portal_intake_requests")
}

// CP1: intake attachment — its own quarantine lifecycle mirroring submission
// files. No uploaded file becomes an accepted Document without a CLEAN scan and
// explicit workforce acceptance during triage. No raw storage path is exposed.
model ClientPortalIntakeAttachment {
  id                         String                     @id @default(uuid())
  intakeRequestId            String
  intakeRequest              ClientPortalIntakeRequest  @relation(fields: [intakeRequestId], references: [id], onDelete: Cascade)
  originalFileNameSafe       String
  declaredMimeType           String?
  detectedMimeType           String?
  sizeBytes                  Int?
  checksum                   String?
  storageProvider            String?
  quarantineStorageReference String?
  status                     ClientSubmissionFileStatus @default(UPLOADING)
  scanProvider               String?
  scanCodeSafe               String?
  uploadedAt                 DateTime?
  scannedAt                  DateTime?
  createdAt                  DateTime                   @default(now())

  @@index([intakeRequestId, status])
  @@map("client_portal_intake_attachments")
}

model ClientOrganizationGroup {
  id              String                        @id @default(uuid())
