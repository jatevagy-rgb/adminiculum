// ============================================================================
// PHASE 2 — CONTRACT LIBRARY (Szerződéstár).
// ContractRecord is the structured legal/business relationship, DISTINCT from
// the physical Document/DocumentVersion. The canonical final DocumentVersion is
// LINKED, never copied. Extensible taxonomies (contractType, party roleCode,
// obligation source/trigger/frequency, entitlement type) are validated STRING
// codes via the server registry — NOT Prisma enums — so new categories never
// require a migration. Stable lifecycles/security use Prisma enums.
// No second Document / Task / org hierarchy / Document ACL is introduced.
// ============================================================================

enum ContractLifecycleStatus {
  DRAFT
  NEGOTIATION
  AWAITING_SIGNATURE
  SIGNED_NOT_EFFECTIVE
  ACTIVE
  TERMINATING
  EXPIRED
  TERMINATED
  SUPERSEDED
}

enum ContractSecurityClassification {
  STANDARD
  RESTRICTED
}

model ContractRecord {
  id                         String                       @id @default(uuid())
  clientId                   String
  client                     Client                       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title                      String
  contractType               String
  status                     ContractLifecycleStatus       @default(DRAFT)
  businessOwnerLabel         String?
  lawFirmOwnerUserId         String?
  lawFirmOwner               User?                        @relation(fields: [lawFirmOwnerUserId], references: [id], onDelete: SetNull)
  sourceCaseId               String?
  sourceCase                 Case?                        @relation(fields: [sourceCaseId], references: [id], onDelete: SetNull)
  canonicalDocumentVersionId String?
  canonicalDocumentVersion   DocumentVersion?             @relation(fields: [canonicalDocumentVersionId], references: [id], onDelete: SetNull)
  signatureDate              DateTime?
  effectiveDate              DateTime?
  expiryDate                 DateTime?
  termType                   String?
  noticePeriodDays           Int?
  autoRenewal                Boolean                      @default(false)
  nextCriticalDate           DateTime?
  securityClassification     ContractSecurityClassification @default(STANDARD)
  internalNote               String?
  parentContractId           String?
  parentContract             ContractRecord?              @relation("ContractFamily", fields: [parentContractId], references: [id], onDelete: SetNull)
  amendments                 ContractRecord[]             @relation("ContractFamily")
  familyRootContractId       String?
  familyRootContract         ContractRecord?              @relation("ContractFamilyRoot", fields: [familyRootContractId], references: [id], onDelete: SetNull)
  rootFamilyMembers          ContractRecord[]             @relation("ContractFamilyRoot")
  parties                    ContractParty[]
  obligations                ClientObligation[]
  entitlements               ContractEntitlement[]
  businessOwnerPersonId      String?
  businessOwnerPerson        OrganizationPerson?           @relation(fields: [businessOwnerPersonId], references: [id], onDelete: SetNull)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt

  @@index([clientId, status])
  @@index([clientId, expiryDate])
  @@index([clientId, nextCriticalDate])
  @@index([canonicalDocumentVersionId])
  @@index([parentContractId])
  @@index([familyRootContractId])
  @@index([businessOwnerPersonId])
  @@map("contract_records")
}

model ContractParty {
  id                 String         @id @default(uuid())
  contractId         String
  contract           ContractRecord @relation(fields: [contractId], references: [id], onDelete: Cascade)
  roleCode           String
  displayName        String
  registrationNumber String?
  taxNumber          String?
  country            String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([contractId])
  @@map("contract_parties")
