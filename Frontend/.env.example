# ============================================================================
# ADMINICULUM FRONTEND CONFIGURATION (NO SECRETS)
# ============================================================================
# Local dev defaults (starter-compatible): frontend 3000 -> backend 3001

# Canonical backend host (do NOT append /api/v1 here)
NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:3001

# Legacy compatibility alias (optional during transition)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# MSAL / Entra public config (canonical)
NEXT_PUBLIC_ENTRA_TENANT_ID=<entra-tenant-id>
NEXT_PUBLIC_ENTRA_CLIENT_ID=<entra-client-id>
# NEXT_PUBLIC_ENTRA_AUTHORITY=https://login.microsoftonline.com/<entra-tenant-id>
# NEXT_PUBLIC_ENTRA_REDIRECT_URI=http://localhost:3000
# NEXT_PUBLIC_ENTRA_POST_LOGOUT_REDIRECT_URI=http://localhost:3000
NEXT_PUBLIC_ADMINICULUM_API_SCOPE=api://<backend-api-app-id>/<scope-name>

# Legacy compatibility aliases (optional; prefer NEXT_PUBLIC_ENTRA_*)
# NEXT_PUBLIC_AZURE_TENANT_ID=<legacy-tenant-id>
# NEXT_PUBLIC_AZURE_CLIENT_ID=<legacy-client-id>
# NEXT_PUBLIC_AZURE_REDIRECT_URI=http://localhost:3000
# NEXT_PUBLIC_AZURE_POST_LOGOUT_REDIRECT_URI=http://localhost:3000

# Local dev auth helpers (never enable in production)
# NEXT_PUBLIC_ENABLE_LOCAL_DEV_AUTH=true
# NEXT_PUBLIC_DEV_LOGIN_EMAIL=attorney@adminiculum.law
# NEXT_PUBLIC_DEV_LOGIN_PASSWORD=Password123!

# Optional feature flags
NEXT_PUBLIC_ENABLE_UI_PACKS=true

