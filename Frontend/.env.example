# Frontend runtime
# Canonical backend host (API path is appended in src/lib/api.ts)
NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:3001
# Legacy alias kept for older local setups (optional)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Auth placeholders (do not commit real tenant/app identifiers or secrets)
NEXT_PUBLIC_AZURE_TENANT_ID=<azure-tenant-id>
NEXT_PUBLIC_AZURE_CLIENT_ID=<azure-client-id>

# Optional feature flags
NEXT_PUBLIC_ENABLE_UI_PACKS=true

