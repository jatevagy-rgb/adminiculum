# ============================================================================
# ADMINICULUM FRONTEND — BOXED DEPLOYMENT ENV EXAMPLE
# Canonical Core only (no optional feature pack env vars needed)
# ============================================================================
# Next.js PUBLIC env vars are prefixed with NEXT_PUBLIC_.
# These are safe to bake into the container image because they are not
# secrets — they are client-direction configuration.
# Real secrets (API keys) are managed server-side via the Backend.
#
# For Azure Container Apps: inject as environment variables at container start.
# For Azure Key Vault: use Key Vault references in container app config.
# ============================================================================

# ============================================================================
# SECTION 1 — REQUIRED: AUTHENTICATION (Entra / Azure AD)
# ============================================================================
# These match the Azure App Registration used by the Backend.

# Azure AD Client ID (Application ID)
NEXT_PUBLIC_ENTRA_CLIENT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Azure AD Tenant ID
NEXT_PUBLIC_ENTRA_TENANT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Azure AD Authority URL
NEXT_PUBLIC_ENTRA_AUTHORITY="https://login.microsoftonline.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# MSAL redirect URI (the frontend's own URL in production)
NEXT_PUBLIC_ENTRA_REDIRECT_URI="https://your-frontend.azurecontainerapps.io"

# MSAL post-logout redirect URI
NEXT_PUBLIC_ENTRA_POST_LOGOUT_REDIRECT_URI="https://your-frontend.azurecontainerapps.io"

# The backend API scope (resource identifier)
NEXT_PUBLIC_ADMINICULUM_API_SCOPE="api://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx/access_as_user"

# ============================================================================
# SECTION 2 — REQUIRED: BACKEND CONNECTION
# ============================================================================
# The frontend needs to know where the backend API lives.
# In Azure Container Apps with two containers, use the service name:
# NEXT_PUBLIC_BACKEND_BASE_URL=http://backend:3001
# In Azure App Service (single backend), use the backend's URL.

NEXT_PUBLIC_BACKEND_BASE_URL="http://backend:3001"

# ============================================================================
# SECTION 3 — LOCAL DEV ONLY (not needed in containers)
# ============================================================================
# These are for local TypeScript compilation and dev server only.
# Not needed in containers.

# Local dev backend URL:
# NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:3001

# Local dev redirect URI:
# NEXT_PUBLIC_ENTRA_REDIRECT_URI=http://localhost:3000
# NEXT_PUBLIC_ENTRA_POST_LOGOUT_REDIRECT_URI=http://localhost:3000
